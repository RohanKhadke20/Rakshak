# Database connection string for PostgreSQL (used by Prisma ORM)
DATABASE_URL="postgresql://postgres:7972@localhost:5432/Rakshak_db?schema=public"
JWT_SECRET="your-secure-jwt-secret-key"
# Backend configuration
PORT=5000
NODE_ENV=development
JWT_SECRET="rakshak-super-secret-key-change-in-production"

# Frontend configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api
