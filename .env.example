# Database connection string for PostgreSQL (used by Prisma ORM)
DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5432/rakshak_db?schema=public"

# Backend configuration
PORT=5000
NODE_ENV=development
JWT_SECRET="your_strong_random_jwt_secret_key_here"

# Frontend configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api
